#!/bin/bash
# Pre-commit hook: sync tracked files from reframework/autorun/ originals.
# Ensures the latest autorun changes are committed.

AUTORUN_BASE="/mnt/c/Program Files (x86)/Steam/steamapps/common/Street Fighter 6/reframework/autorun"
TRACKED_FILES=(
    "attack_info.lua"
    "attack_history.lua"
    "better_disp_hitboxes.lua"
    "better_info_display.lua"
    "replay_id_to_clipboard.lua"
)

for f in "${TRACKED_FILES[@]}"; do
    src="$AUTORUN_BASE/$f"
    if [ -f "$src" ]; then
        cp -L "$src" "$f"
        git add "$f"
    else
        echo "WARNING: $src not found, skipping sync for $f"
    fi
done
